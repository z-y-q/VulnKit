{
  "TECH_PATTERNS": [
    { "target": "meta", "field": "name", "pattern": "generator", "extract": "content", "label": "CMS/生成器", "color": "purple" },
    { "target": "meta", "field": "name", "pattern": "viewport", "extract": "content", "label": "移动端视口", "color": "gray" },
    { "target": "meta", "field": "name", "pattern": "description", "extract": "content", "label": "页面描述", "color": "gray" },
    { "target": "meta", "field": "name", "pattern": "keywords", "extract": "content", "label": "关键词", "color": "gray" },
    { "target": "meta", "field": "name", "pattern": "author", "extract": "content", "label": "作者", "color": "gray" },
    { "target": "meta", "field": "name", "pattern": "theme-color", "extract": "content", "label": "主题色", "color": "gray" },
    { "target": "meta", "field": "name", "pattern": "application-name", "extract": "content", "label": "应用名", "color": "gray" },
    { "target": "meta", "field": "property", "pattern": "og:title", "extract": "content", "label": "OG标题", "color": "gray" },
    { "target": "meta", "field": "property", "pattern": "og:description", "extract": "content", "label": "OG描述", "color": "gray" },
    { "target": "meta", "field": "property", "pattern": "og:image", "extract": "content", "label": "OG图片", "color": "gray" },
    { "target": "meta", "field": "property", "pattern": "og:url", "extract": "content", "label": "OG URL", "color": "gray" },
    { "target": "meta", "field": "property", "pattern": "og:type", "extract": "content", "label": "OG类型", "color": "gray" },
    { "target": "meta", "field": "http-equiv", "pattern": "X-UA-Compatible", "extract": "content", "label": "兼容模式", "color": "gray" },
    { "target": "meta", "field": "http-equiv", "pattern": "Content-Security-Policy", "extract": "content", "label": "CSP策略", "color": "green" },
    { "target": "meta", "field": "name", "pattern": "referrer", "extract": "content", "label": "Referrer策略", "color": "gray" },
    { "target": "meta", "field": "name", "pattern": "robots", "extract": "content", "label": "Robots", "color": "gray" },
    { "target": "scriptSrc", "pattern": "/wp-content/", "label": "WordPress", "color": "blue" },
    { "target": "scriptSrc", "pattern": "/wp-includes/", "label": "WordPress", "color": "blue" },
    { "target": "scriptSrc", "pattern": "jquery[.-]", "label": "jQuery", "color": "blue" },
    { "target": "scriptSrc", "pattern": "react\\.production", "label": "React", "color": "cyan" },
    { "target": "scriptSrc", "pattern": "react-dom", "label": "React DOM", "color": "cyan" },
    { "target": "scriptSrc", "pattern": "vue\\.", "label": "Vue.js", "color": "green" },
    { "target": "scriptSrc", "pattern": "vuex\\.|pinia", "label": "Vuex/Pinia", "color": "green" },
    { "target": "scriptSrc", "pattern": "vue-router", "label": "Vue Router", "color": "green" },
    { "target": "scriptSrc", "pattern": "angular", "label": "Angular", "color": "red" },
    { "target": "scriptSrc", "pattern": "nuxt\\.", "label": "Nuxt.js", "color": "green" },
    { "target": "scriptSrc", "pattern": "next\\.", "label": "Next.js", "color": "gray" },
    { "target": "scriptSrc", "pattern": "svelte", "label": "Svelte", "color": "orange" },
    { "target": "scriptSrc", "pattern": "bootstrap", "label": "Bootstrap", "color": "purple" },
    { "target": "scriptSrc", "pattern": "tailwind", "label": "Tailwind CSS", "color": "cyan" },
    { "target": "scriptSrc", "pattern": "element-ui|element-plus", "label": "Element UI", "color": "blue" },
    { "target": "scriptSrc", "pattern": "antd|ant-design", "label": "Ant Design", "color": "blue" },
    { "target": "scriptSrc", "pattern": "axios", "label": "Axios", "color": "purple" },
    { "target": "scriptSrc", "pattern": "lodash", "label": "Lodash", "color": "gray" },
    { "target": "scriptSrc", "pattern": "moment\\.|min\\.moment", "label": "Moment.js", "color": "gray" },
    { "target": "scriptSrc", "pattern": "d3\\.", "label": "D3.js", "color": "orange" },
    { "target": "scriptSrc", "pattern": "echarts", "label": "ECharts", "color": "red" },
    { "target": "scriptSrc", "pattern": "highcharts", "label": "Highcharts", "color": "blue" },
    { "target": "scriptSrc", "pattern": "three\\.", "label": "Three.js", "color": "gray" },
    { "target": "scriptSrc", "pattern": "chart\\.js", "label": "Chart.js", "color": "red" },
    { "target": "scriptSrc", "pattern": "socket\\.io", "label": "Socket.IO", "color": "gray" },
    { "target": "scriptSrc", "pattern": "google-analytics|gtag|ga\\.js", "label": "Google Analytics", "color": "orange" },
    { "target": "scriptSrc", "pattern": "google-tag-manager|gtm\\.js", "label": "GTM", "color": "orange" },
    { "target": "scriptSrc", "pattern": "fontawesome|fa\\.", "label": "Font Awesome", "color": "gray" },
    { "target": "scriptSrc", "pattern": "swagger-ui", "label": "Swagger UI", "color": "green" },
    { "target": "scriptSrc", "pattern": "ruoyi", "label": "RuoYi", "color": "red" },
    { "target": "scriptSrc", "pattern": "alipay|支付宝", "label": "支付宝SDK", "color": "blue" },
    { "target": "scriptSrc", "pattern": "weixin|jssdk|wechat", "label": "微信SDK", "color": "green" },
    { "target": "body", "pattern": "__NEXT_DATA__", "label": "Next.js SSR", "color": "gray" },
    { "target": "body", "pattern": "__NUXT__", "label": "Nuxt.js SSR", "color": "green" },
    { "target": "body", "pattern": "__VUE_DEVTOOLS", "label": "Vue DevTools", "color": "green" },
    { "target": "body", "pattern": "ng-version", "label": "Angular", "color": "red" },
    { "target": "body", "pattern": "data-reactroot|data-reactid", "label": "React", "color": "cyan" },
    { "target": "body", "pattern": "__SVELTE_META__|svelte-", "label": "SvelteKit", "color": "orange" },
    { "target": "body", "pattern": "wp-json|wp/v\\d", "label": "WordPress REST", "color": "blue" },
    { "target": "body", "pattern": "powered by\\s+ruoyi|若依", "label": "RuoYi", "color": "red" }
  ],
  "CLOUD_PATTERNS": [
    { "pattern": "aws\\.amazon|amazonaws\\.com", "label": "AWS", "color": "orange" },
    { "pattern": "azure\\.microsoft|windows\\.net|azure\\.com", "label": "Azure", "color": "blue" },
    { "pattern": "googleapis\\.com|gstatic\\.com", "label": "GCP", "color": "cyan" },
    { "pattern": "aliyuncs\\.com|aliyun\\.com", "label": "Aliyun", "color": "orange" },
    { "pattern": "tencentcloud|tencent\\.com", "label": "Tencent Cloud", "color": "blue" },
    { "pattern": "cloudflare", "label": "Cloudflare", "color": "orange" },
    { "pattern": "fastly", "label": "Fastly", "color": "gray" },
    { "pattern": "cdn\\.|c\\.cloudfront\\.net|akamai", "label": "CDN", "color": "purple" }
  ],
  "SENSITIVE_PATTERNS": [
    { "regex": { "__regexp__": true, "source": "AKIA[0-9A-Z]{16}", "flags": "g" }, "label": "AWS Access Key", "color": "red" },
    { "regex": { "__regexp__": true, "source": "-----BEGIN (?:RSA |EC |DSA |OPENSSH )?PRIVATE KEY-----", "flags": "g" }, "label": "Private Key", "color": "red" },
    { "regex": { "__regexp__": true, "source": "eyJ[A-Za-z0-9_-]{10,}\\.eyJ[A-Za-z0-9_-]{10,}\\.eyJ[A-Za-z0-9_-]{10,}", "flags": "g" }, "label": "JWT Token", "color": "yellow" },
    { "regex": { "__regexp__": true, "source": "\\b(?:(?:25[0-5]|2[0-4]\\d|[01]?\\d\\d?)\\.){3}(?:25[0-5]|2[0-4]\\d|[01]?\\d\\d?)\\b", "flags": "g" }, "label": "IP Address", "color": "cyan" },
    { "regex": { "__regexp__": true, "source": "(?:mongodb|mysql|postgres|redis):\\/\\/[^\\s'\"]+", "flags": "gi" }, "label": "DB Connection", "color": "red" },
    { "regex": { "__regexp__": true, "source": "(?:password|passwd|pwd)\\s*[:=]\\s*['\"][^'\"]{4,}['\"]", "flags": "gi" }, "label": "Hardcoded Password", "color": "red" },
    { "regex": { "__regexp__": true, "source": "AIza[0-9A-Za-z_-]{35}", "flags": "g" }, "label": "Google API Key", "color": "yellow" },
    { "regex": { "__regexp__": true, "source": "xox[baprs]-[0-9a-zA-Z-]{10,}", "flags": "g" }, "label": "Slack Token", "color": "red" },
    { "regex": { "__regexp__": true, "source": "(?:ghp|gho|ghu|ghs|ghr)_[A-Za-z0-9_]{36,}", "flags": "g" }, "label": "GitHub Token", "color": "red" },
    { "regex": { "__regexp__": true, "source": "[\"'](api[_-]?key|apikey|api[_-]?secret)[\"']\\s*[:=]\\s*[\"']([^\"']{8,})[\"']", "flags": "gi" }, "label": "API Key", "color": "yellow", "captureIdx": 2 },
    { "regex": { "__regexp__": true, "source": "-----BEGIN RSA PRIVATE KEY-----", "flags": "g" }, "label": "RSA Private Key", "color": "red" },
    { "regex": { "__regexp__": true, "source": "sk-[A-Za-z0-9]{20,}", "flags": "g" }, "label": "API Secret Key", "color": "red" },
    { "regex": { "__regexp__": true, "source": "Bearer\\s+[A-Za-z0-9_\\-\\.]+", "flags": "gi" }, "label": "Bearer Token", "color": "yellow" },
    { "regex": { "__regexp__": true, "source": "firebase[A-Za-z0-9_-]+\\.firebaseio\\.com", "flags": "g" }, "label": "Firebase URL", "color": "yellow" }
  ],
  "API_PATTERNS": [
    { "regex": { "__regexp__": true, "source": "(?:fetch|axios|\\.get|\\.post|\\.put|\\.delete|\\.patch|\\.request)\\s*\\(\\s*[\"']([^\"']+)[\"']", "flags": "gi" }, "label": "fetch" },
    { "regex": { "__regexp__": true, "source": "(?:url|endpoint|api|baseUrl|baseURL|apiUrl|apiURL)[\"']?\\s*[:=]\\s*[\"']([^\"']+)[\"']", "flags": "gi" }, "label": "config" },
    { "regex": { "__regexp__": true, "source": "[\"'](\\/api\\/[a-zA-Z0-9_\\-./{}:?&=]*)[\"']", "flags": "gi" }, "label": "api-path" },
    { "regex": { "__regexp__": true, "source": "[\"'](\\/v\\d+(?:\\/[a-zA-Z0-9_\\-./{}:?&=]*)*)[\"']", "flags": "gi" }, "label": "versioned" },
    { "regex": { "__regexp__": true, "source": "path:\\s*[\"']([^\"']+)[\"']", "flags": "gi" }, "label": "route-path" },
    { "regex": { "__regexp__": true, "source": "@(?:Get|Post|Put|Delete|Patch|Route)\\s*\\(\\s*[\"']([^\"']+)[\"']", "flags": "gi" }, "label": "decorator" },
    { "regex": { "__regexp__": true, "source": "[\"']((?:\\/[a-zA-Z0-9_-]+){2,}(?:\\/[a-zA-Z0-9_-{}:?&=]*)*)[\"']", "flags": "g" }, "label": "path" }
  ],
  "STORAGE_SENSITIVE_KEYS": "token|key|secret|session|auth|user|admin|password|passwd|pwd|token|access|refresh|jwt"
}
