{
  "name": "lingmou-v6",
  "description": "灵眸 - 编码解码、图标识别、资产测绘、信息收集、权限分析",
  "private": true,
  "version": "7.2.0",
  "type": "module",
  "packageManager": "pnpm@10.30.3",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "clean:inject": "find public/inject -name '*.js' -delete",
    "build:inject": "pnpm run clean:inject && tsc -p tsconfig.inject.json",
    "dev:inject": "tsc -p tsconfig.inject.json --watch",
    "dev": "pnpm run build:inject && wxt",
    "dev:firefox": "pnpm run build:inject && wxt -b firefox",
    "build": "pnpm run build:inject && wxt build",
    "build:firefox": "pnpm run build:inject && wxt build -b firefox",
    "zip": "pnpm run build:inject && wxt zip",
    "zip:firefox": "pnpm run build:inject && wxt zip -b firefox",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "lint": "eslint src",
    "postinstall": "wxt prepare"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^7.2.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/svelte": "^5.4.2",
    "@tsconfig/svelte": "^5.0.8",
    "@types/crypto-js": "^4.2.2",
    "@types/js-yaml": "^4.0.9",
    "@vitest/coverage-v8": "^4.1.10",
    "@wxt-dev/module-svelte": "^2.0.4",
    "@wxt-dev/unocss": "^1.0.1",
    "jsdom": "^29.1.1",
    "svelte": "^5.53.7",
    "svelte-check": "^4.4.4",
    "tslib": "^2.8.1",
    "typescript": "^5.9.3",
    "unocss": "^66.7.5",
    "vitest": "^4.1.10",
    "wxt": "^0.20.27"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "crypto-js": "^4.2.0",
    "fflate": "^0.8.3",
    "js-yaml": "^5.2.1",
    "sm-crypto": "^0.4.0"
  }
}
