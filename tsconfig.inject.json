{
  "compilerOptions": {
    "target": "ES2020",
    "module": "None",
    "moduleResolution": "Node",
    "noEmit": false,
    "declaration": false,
    "sourceMap": false,
    "removeComments": false,
    "outDir": "public/inject",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "skipLibCheck": true,
    "strict": false
  },
  "include": ["src/inject/**/*.ts"]
}
