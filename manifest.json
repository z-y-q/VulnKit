{
  "manifest_version": 3,
  "name": "灵眸",
  "version": "5.0.0",
  "description": "灵眸 - 编码解码、图标识别、资产测绘、信息收集、权限分析",
  "permissions": [
    "activeTab",
    "storage",
    "scripting",
    "contextMenus",
    "declarativeNetRequestWithHostAccess",
    "cookies",
    "downloads"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "src/background/background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["src/content/vk-content.js"],
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["src/inject/vue-detect.js", "src/inject/ruoyi-route-hook.js", "src/inject/vue-store-explorer.js", "src/inject/react-detect.js", "src/inject/angular-detect.js", "src/inject/sourcemap-detect.js", "src/inject/page-inspect.js"],
      "matches": ["<all_urls>"]
    }
  ],
  "action": {
    "default_popup": "src/popup/popup.html",
    "default_title": "灵眸 - 漏洞工具包"
  },
  "options_page": "src/options/options.html",
  "content_security_policy": {
    "extension_pages": "script-src 'self'; connect-src *; object-src 'self';"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
